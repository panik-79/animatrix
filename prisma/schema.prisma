// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  passwordHash  String
  image         String?
  gender        String?
  dateOfBirth   String?
  bio           String?
  role          String          @default("USER")
  isOnboarded   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sessions      Session[]
  accounts      Account[]
  preference    UserPreference?
  libraryEntries LibraryEntry[]
  collections   Collection[]
  watchHistory  WatchHistory[]
  userSettings  UserSettings[]
  reviews       AnimeReview[]
  reviewComments ReviewComment[]
  reviewLikes   ReviewLike[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // JSON encoded string arrays or comma-separated lists for SQLite compatibility
  genres           String   @default("[]") // JSON string array e.g. ["Action", "Fantasy"]
  favoriteAnimeIds String   @default("[]") // JSON string array of AniList IDs e.g. ["153518", "4224"]
  moods            String   @default("[]") // JSON string array e.g. ["Epic", "Dark"]
  avoidTags        String   @default("[]") // JSON string array e.g. ["Ecchi", "Gore"]
  
  preferredLength  String   @default("NO_PREFERENCE") // MOVIES | 12_EPISODES | 24_EPISODES | LONG_SERIES | NO_PREFERENCE
  preferredEra     String   @default("NO_PREFERENCE") // CLASSICS | MODERN | SEASONAL | NO_PREFERENCE
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum WatchStatus {
  WATCHING
  COMPLETED
  PLAN_TO_WATCH
  ON_HOLD
  DROPPED
}

model LibraryEntry {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  animeId         String      // Unique provider key e.g. "jikan:4224" or "anilist:153518"
  malId           Int?
  anilistId       Int?
  title           String
  imageUrl        String?
  bannerUrl       String?
  status          WatchStatus @default(WATCHING)
  score           Float?      // 1.0 - 10.0 score
  progress        Int         @default(0) // Episodes watched
  totalEpisodes   Int?
  rewatchCount    Int         @default(0)
  isFavorite      Boolean     @default(false)
  notes           String?
  startDate       DateTime?
  completedDate   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, animeId])
  @@index([userId])
}

model Collection {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverImage  String?
  isPinned    Boolean          @default(false)
  isHidden    Boolean          @default(false)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CollectionItem[]
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  animeId      String
  title        String
  imageUrl     String?
  sortOrder    Int        @default(0)
  note         String?
  createdAt    DateTime   @default(now())

  @@unique([collectionId, animeId])
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  animeId   String
  episode   Int
  watchedAt DateTime @default(now())
}

model UserSettings {
  id        String   @id @default("default")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String   // JSON payload for settings
  updatedAt DateTime @updatedAt
}

// ─── Collaborative Reviews & Comments ────────────────────────────────────────

model AnimeReview {
  id        String          @id @default(cuid())
  animeId   String          // Provider key e.g. "jikan:4224"
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Float?          // 1.0–10.0
  body      String          // Review text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  comments  ReviewComment[]
  likes     ReviewLike[]

  @@unique([animeId, userId])  // One review per user per anime
}

model ReviewComment {
  id        String         @id @default(cuid())
  reviewId  String
  review    AnimeReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  parentId  String?        // null = root comment; set = reply to parentId
  parent    ReviewComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ReviewComment[] @relation("CommentReplies")
  createdAt DateTime       @default(now())
}

model ReviewLike {
  id        String      @id @default(cuid())
  reviewId  String
  review    AnimeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([reviewId, userId])  // One like per user per review
}

